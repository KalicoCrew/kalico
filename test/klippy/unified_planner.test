# unified_planner normal queued motion and live state changes.
DICTIONARY atmega2560.dict
CONFIG unified_planner.cfg

G28
G1 X20 Y20 Z1 F6000
G1 X60 Y20 E0.5 F9000
G1 X60 Y60 E1.0 F9000
M400
SET_UNIFIED
SET_UNIFIED ENABLE=1 NOTCH_FREQ=60 MAX_DA=50
G1 X80 Y80 E1.5 F12000
SET_UNIFIED NOTCH_FREQ_X=70 NOTCH_FREQ_Y=55
G1 X120 Y80 E2.0 F12000
RESET_VELOCITY_LIMIT
G1 X100 Y100 E2.5 F9000
M400
