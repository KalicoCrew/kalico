# Pressure advance and input shaping of the extruder motion
CONFIG extruder_shaping.cfg
DICTIONARY atmega2560.dict

G28
G1 Z5 F600
M82
SET_HEATER_TEMPERATURE HEATER=extruder TARGET=0
M302 S0

# Print moves with the configured shaper and smoother
G1 X50 Y50 E2 F6000
G1 X100 Y50 E4
G1 X100 Y100 E6

# Pressure advance changes while moves are queued
SET_PRESSURE_ADVANCE ADVANCE=0.04
G1 X50 Y100 E8
SET_PRESSURE_ADVANCE ADVANCE=0
G1 X50 Y50 E10
SET_PRESSURE_ADVANCE ADVANCE=0.03 TIME_OFFSET=0.005 SMOOTH_TIME=0.03
G1 X100 Y50 E12

# Non-linear pressure advance models
SET_PRESSURE_ADVANCE MODEL=tanh ADVANCE=0.02 OFFSET=0.05 VELOCITY=2
G1 X100 Y100 E14
SET_PRESSURE_ADVANCE MODEL=recipr ADVANCE=0.02 OFFSET=0.05 VELOCITY=2
G1 X50 Y100 E16
SET_PRESSURE_ADVANCE MODEL=linear ADVANCE=0.02

# Shaper and smoother changes, including exact extruder synchronization
SET_INPUT_SHAPER SHAPER_TYPE_X=smooth_ei SHAPER_FREQ_X=40
G1 X50 Y50 E18
SET_INPUT_SHAPER SHAPER_TYPE_X=ei SHAPER_FREQ_X=45
G1 X100 Y50 E20
SET_INPUT_SHAPER SHAPER_TYPE_X=mzv SHAPER_FREQ_X=45 SHAPER_TYPE_Y=mzv SHAPER_FREQ_Y=45
G1 X100 Y100 E22
DISABLE_INPUT_SHAPER
G1 X50 Y100 E24
ENABLE_INPUT_SHAPER

# Extrude only moves and retractions
G1 E26 F600
G1 E22 F1800
G1 X60 Y60 F6000
G1 E24 F1800
