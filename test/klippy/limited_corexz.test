# Tests for limited_cartesian
DICTIONARY atmega2560.dict
CONFIG limited_corexz.cfg

; Start by homing the printer.
G28
CHECK_LIMITS MAX_X_ACCEL=1200 MAX_Y_ACCEL=900 MAX_Z_VELOCITY=25 MAX_Z_ACCEL=30 SCALE_XY_ACCEL=1
G90
G1 F6000

M204 S1000

; Z / X / Y moves
G1 Z1
G1 X1
G1 Y1

; test SET_KINEMATICS_LIMIT
M204 S15000
SET_KINEMATICS_LIMIT X_ACCEL=12000 Y_ACCEL=900 SCALE=0
SET_KINEMATICS_LIMIT
CHECK_LIMITS MAX_X_ACCEL=12000 MAX_Y_ACCEL=900 MAX_Z_ACCEL=30 SCALE_XY_ACCEL=0
SET_KINEMATICS_LIMIT Z_ACCEL=20
CHECK_LIMITS MAX_Z_ACCEL=20
SET_KINEMATICS_LIMIT Z_ACCEL=30
SET_VELOCITY_LIMIT Z_ACCEL=15 X_ACCEL=1100
CHECK_LIMITS MAX_Z_ACCEL=15 MAX_X_ACCEL=1100
RESET_VELOCITY_LIMIT
CHECK_LIMITS MAX_Z_ACCEL=30 MAX_X_ACCEL=1200

; diagonal moves
G1 X0 Y0
G1 X1 Z2
G1 X0 Y1 Z1

; regular extrude move
G1 X0 Y0 E.01
